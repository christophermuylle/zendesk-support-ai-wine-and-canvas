# --- Zendesk ---
# Your Zendesk subdomain, e.g. if your Zendesk URL is https://paintingandvino.zendesk.com
# then ZENDESK_SUBDOMAIN=paintingandvino
ZENDESK_SUBDOMAIN=
# The email of the agent/admin account the API token belongs to
ZENDESK_EMAIL=
# Admin Center > Apps and integrations > APIs > Zendesk API > Add API token
ZENDESK_API_TOKEN=
# Shared secret you invent and also paste into the Zendesk webhook config,
# used to verify inbound webhook calls really came from Zendesk.
ZENDESK_WEBHOOK_SECRET=

# --- AI ---
# https://console.anthropic.com/ -> Get API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Behavior ---
# draft  = AI writes a suggested reply + status as an INTERNAL NOTE for a human to approve and send
# auto   = AI replies to the customer and updates ticket status automatically
MODE=draft

# Which brand this deployment is answering for: wine_and_canvas | painting_and_vino
# (Run two deployments, one per brand, if you want separate knowledge bases/rules.)
BRAND=painting_and_vino

# Port the webhook server listens on
PORT=3000
